---
import DistroLogo from "../components/logos/distro-logo.astro";
import Prompt from "../components/prompt.astro";
import SectionTitle from "../components/section-title.astro";
import Layout from "../layouts/default.astro";
import { type Distro, distros } from "../lib/themes";

/** `perDistro` marca las filas cuyo valor cambia con la distro activa */
const info: {
    k: string;
    v?: string;
    dim?: boolean;
    perDistro?: (distro: Distro) => string;
}[] = [
    { k: "OS", perDistro: (distro) => distro.os },
    { k: "Host", v: "ThinkPad X1 Carbon Gen 11" },
    { k: "Kernel", v: "6.7.4-arch1-1" },
    { k: "Uptime", v: "since 2019 (btw)" },
    { k: "Packages", perDistro: (distro) => `4 (${distro.pkg})` },
    { k: "Shell", v: "zsh 5.9" },
    { k: "Resolution", v: "1920x1080" },
    { k: "DE", v: "N/A", dim: true },
    { k: "WM", v: "i3" },
    { k: "Theme", v: "catppuccin-mocha" },
    { k: "Terminal", v: "kitty + zellij" },
    { k: "CPU", v: "Intel i7-1165G7 (8) @ 4.7GHz" },
    { k: "GPU", v: "Intel Iris Xe" },
    { k: "Memory", v: "8421MiB / 32128MiB" },
];
---

<Layout
    title="ansango · arch"
    description="ansango — portfolio fastfetch style"
>
    <!-- ── fastfetch ─────────────────────────────────────── -->
    <div
        class="mb-10 flex flex-col items-start gap-[0.8rem] md:flex-row md:gap-12"
    >
        <DistroLogo />
        <div class="text-[0.92rem] md:pt-[0.3rem]">
            <div class="mb-[0.2rem] text-base font-medium text-accent">
                ansango<span class="text-dim">@</span>dev
            </div>
            <div class="mb-2 tracking-[-0.05em] text-dim">────────────────</div>
            {
                info.map(({ k, v, dim, perDistro }) => (
                    <div class="mb-[0.05rem]">
                        <span class="inline-block min-w-[70px] font-medium text-accent md:min-w-[90px]">
                            {k}
                        </span>
                        {perDistro ? (
                            distros.map((distro) => (
                                <span data-distro={distro.slug}>
                                    {perDistro(distro)}
                                </span>
                            ))
                        ) : (
                            <span class:list={[dim && "text-dim"]}>{v}</span>
                        )}
                    </div>
                ))
            }
        </div>
    </div>

    <!-- ── about ─────────────────────────────────────────── -->
    <section class="my-10">
        <SectionTitle title="about" />
        <Prompt cmd="lazygit --view bio" />
        <pre
            class="my-2 overflow-x-auto text-[0.82rem] leading-normal whitespace-pre">
<span class="text-dim">┌─ status ──────────────────────────────────────────────────────────────────┐</span>
│ <span class="font-medium text-accent">⎇ main</span>  ·  since 2019  ·  <span class="text-dim">+3 modified · 1 untracked</span>                          │
<span class="text-dim">└──────────────────────────────────────────────────────────────────────────┘</span>
<span class="text-dim">┌─ bio (modified) ─────────────────────────────────────────────────────────┐</span>
│  <span class="font-medium text-accent">M</span>  Construyo software limpio, minimalista y funcional                    │
│  <span class="font-medium text-accent">M</span>  Me obsesionan los detalles pequeños: tipografía                        │
│  <span class="font-medium text-accent">M</span>  Rendimiento, latencia, buenas APIs                                    │
│  <span class="text-dim">??</span> Construyo software limpio. Sí, uso Arch.                     │
<span class="text-dim">└──────────────────────────────────────────────────────────────────────────┘</span>
<span class="text-dim">┌─ paths (local) ──────────────────────────────────────────────────────────┐</span>
│  <span class="font-medium text-accent">* main</span>                                                              │
│    feature/webdev                                                           │
│    feature/security-research                                                │
│    feature/ctf-writeups                                                     │
<span class="text-dim">└──────────────────────────────────────────────────────────────────────────┘</span>
</pre>
    </section>

    <!-- ── projects ──────────────────────────────────────── -->
    <section class="my-10">
        <SectionTitle title="projects" />
        <Prompt cmd="ranger /home/ansango/projects" />
        <div
            class="my-2 grid grid-cols-1 border border-border bg-panel md:grid-cols-2"
        >
            <pre
                class="m-0 overflow-x-auto border-b border-border p-4 text-[0.82rem] leading-[1.55] whitespace-pre md:border-r md:border-b-0">
<span class="text-dim">/home/ansango</span>
└── projects/  <span class="text-dim">(4 items, 96K total)</span>
    ┌── <span class="text-accent">project.alpha</span> <span class="text-dim">  4.0K</span> <span class="text-dim">Jan 15</span>
    ├── project.beta    <span class="text-dim">  4.0K</span> <span class="text-dim">Feb 20</span>
    ├── project.gamma   <span class="text-dim">  4.0K</span> <span class="text-dim">Mar 10</span>
    └── project.delta   <span class="text-dim">  4.0K</span> <span class="text-dim">Apr 05</span>
</pre>
            <div class="p-4">
                <div class="mb-[0.3rem] text-base font-medium text-accent">
                    project.alpha
                </div>
                <div class="mb-2 text-[0.88rem]">
                    CLI tool for automating dev workflows — npm, git, docker
                </div>
                <div class="text-[0.78rem] text-dim">
                    github.com/ansango/alpha
                </div>
                <div class="text-[0.78rem] text-dim">
                    ★ 1.2k · updated 2 weeks ago
                </div>
                <a
                    class="mt-[0.4rem] inline-block text-[0.85rem] text-accent hover:underline"
                    href="https://github.com/ansango/alpha"
                    target="_blank"
                    rel="noopener">→ open in browser</a
                >
            </div>
        </div>
    </section>

    <!-- ── uses ──────────────────────────────────────────── -->
    <section class="my-10">
        <SectionTitle title="uses" />
        <Prompt
            cmd="btop --view stack — daily usage & hardware"
            class="mb-[0.4rem]"
        />
        <pre
            class="my-2 overflow-x-auto text-[0.7rem] leading-normal whitespace-pre md:text-[0.82rem]">
<span class="text-dim">┌─ CPU [daily usage] ───────────────────────────────────────────────────────┐</span>
│ <span>editor      </span> <span class="text-accent">████████████████████</span> <span class="text-dim">100%</span>  <span>neovim 0.9.5</span>           <span class="text-dim">(lazyvim distro)</span> │
│ <span>terminal    </span> <span class="text-accent/70">██████████████░░░░░░</span> <span class="text-dim"> 60%</span>  <span>kitty + zellij 0.39.1</span>                  │
│ <span>shell       </span> <span class="text-accent/60">██████████░░░░░░░░░░</span> <span class="text-dim"> 50%</span>  <span>zsh + oh-my-zsh + starship</span>             │
│ <span>cli tools   </span> <span class="text-accent/60">██████████░░░░░░░░░░</span> <span class="text-dim"> 50%</span>  <span>fzf · ripgrep · fd · bat · eza</span>          │
│ <span>browser     </span> <span class="text-accent/30">████░░░░░░░░░░░░░░░░</span> <span class="text-dim"> 20%</span>  <span>firefox developer edition</span>               │
│ <span>notes       </span> <span class="text-accent/20">██░░░░░░░░░░░░░░░░░░</span> <span class="text-dim"> 10%</span>  <span>obsidian</span>                <span class="text-dim">(syncthing)</span>   │
│ <span>music       </span> <span class="text-accent/20">██░░░░░░░░░░░░░░░░░░</span> <span class="text-dim"> 10%</span>  <span>spotify + spicetify</span>                     │
│ <span>theme       </span> <span class="text-accent/60">██████████░░░░░░░░░░</span> <span class="text-dim"> 50%</span>  <span>catppuccin mocha</span>                        │
│ <span>font        </span> <span class="text-accent/50">████████░░░░░░░░░░░░</span> <span class="text-dim"> 40%</span>  <span>jetbrains mono</span>                          │
<span class="text-dim">└──────────────────────────────────────────────────────────────────────────┘</span>

<span class="text-dim">┌─ MEM ─────────────────────────────────────────────────────────────────────┐</span>
│ <span>RAM         </span> <span class="text-accent">████████░░░░░░░░░░░░░░░░░░░</span> 8.2/32 GB  <span class="text-accent">catppuccin 100%</span>          │
<span class="text-dim">└──────────────────────────────────────────────────────────────────────────┘</span>

<span class="text-dim">┌─ hardware ────────────────────────────────────────────────────────────────┐</span>
│ thinkpad x1 carbon gen 11  ·  32gb ram  ·  <span class="text-accent">arch linux</span>           │
<span class="text-dim">└──────────────────────────────────────────────────────────────────────────┘</span>
</pre>
    </section>

    <!-- ── contact ───────────────────────────────────────── -->
    <section class="my-10">
        <SectionTitle title="contact" />
        <Prompt cmd="mutt -f ansango@dev" />
        <pre
            class="my-2 overflow-x-auto text-[0.82rem] leading-[1.6] whitespace-pre">
  <span class="text-dim">From</span>             <span class="text-dim">Subject</span>                          <span class="text-dim">Date</span>
<span class="font-medium text-accent">&gt;</span> <span>github.com</span>     /ansango                             <span class="text-dim">15 Aug 2014</span>
  <span>twitter.com</span>    @ansango                             <span class="text-dim">22 Mar 2015</span>
  <span>ansango.dev</span>    hola@ansango.dev                     <span class="text-dim">10 Jan 2019</span>
</pre>
        <div class="mt-2 text-[0.8rem] text-dim">
            j/k next · <span class="text-accent">enter</span> open · q quit
        </div>
    </section>

    <!-- ── footer ────────────────────────────────────────── -->
    <footer class="mt-10 text-[0.8rem] text-dim">
        <div class="flex flex-wrap items-center gap-2 text-[0.85rem]">
            <span class="text-accent">●</span>
            <span>session closed</span>
            <span class="text-border">·</span>
            <span>0 errors</span>
            <span class="text-border">·</span>
            <span>0 warnings</span>
            <span class="text-border">·</span>
            <span>uptime 5y</span>
            <span class="text-border">·</span>
            <span class="text-fg">arch linux · rolling · btw</span>
            <span class="text-border">·</span>
            <a href="mailto:hola@ansango.dev" class="text-accent"
                >hola@ansango.dev</a
            >
        </div>
    </footer>
</Layout>
