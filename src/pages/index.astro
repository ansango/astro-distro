---
import DistroLogo from "../components/logos/distro-logo.astro";
import SectionTitle from "../components/section-title.astro";
import Btop from "../components/tui/btop/index.astro";
import Lazygit from "../components/tui/lazygit/index.astro";
import Mutt from "../components/tui/mutt/index.astro";
import Ranger from "../components/tui/ranger/index.astro";
import config from "../config.json";
import Layout from "../layouts/default.astro";

const { current, systems: distros } = config;
type System = (typeof distros)[number];

/** `perDistro` marca las filas cuyo valor cambia con la distro activa */
const info: {
  k: string;
  v?: string;
  dim?: boolean;
  perDistro?: (system: System) => string;
}[] = [
  { k: "OS", perDistro: (s) => s.os },
  { k: "Host", v: current.host },
  { k: "Kernel", perDistro: (s) => s.kernel },
  { k: "Uptime", v: current.uptime },
  { k: "Packages", perDistro: (s) => `${s.pkgs} (${s.pkg})` },
  { k: "Shell", perDistro: (s) => s.shell },
  { k: "Resolution", v: current.resolution },
  { k: "DE", perDistro: (s) => s.de, dim: true },
  { k: "WM", perDistro: (s) => s.wm },
  { k: "Theme", perDistro: (s) => s.theme },
  { k: "Terminal", perDistro: (s) => s.terminal },
  { k: "Font", perDistro: (s) => s.font },
  { k: "CPU", v: current.cpu },
  { k: "GPU", v: current.gpu },
  { k: "Memory", v: current.memory },
];
---

<Layout
  title="ansango · arch"
  description="ansango — portfolio fastfetch style"
>
  <!-- ── fastfetch ─────────────────────────────────────── -->
  <div class="mb-10 flex flex-col items-start md:flex-row gap-6 md:gap-12">
    <DistroLogo />
    <div class="text-[0.92rem] md:pt-[0.3rem]">
      <div class="mb-[0.2rem] text-base font-medium text-accent">
        ansango<span class="text-dim">@</span>dev
      </div>
      <div class="mb-2 tracking-tighter text-dim">────────────────</div>
      {info.map(({ k, v, dim, perDistro }) => (
                    <div class="mb-[0.05rem] flex items-center gap-2">
                        <span class="inline-block font-medium text-accent min-w-[90px]">
                            {k}
                        </span>
                        {perDistro ? (
                            distros.map((distro) => (
                                <span data-distro={distro.slug}>
                                    {perDistro(distro)}
                                </span>
                            ))
                        ) : (
                            <span class:list={[dim && "text-dim"]}>{v}</span>
                        )}
                    </div>
                ))}
    </div>
  </div>

  <!-- ── about ─────────────────────────────────────────── -->
  <section class="my-10">
    <SectionTitle title="about" />
    <Lazygit />
  </section>

  <!-- ── projects ──────────────────────────────────────── -->
  <section class="my-10">
    <SectionTitle title="projects" />
    <Ranger />
  </section>

  <!-- ── uses ──────────────────────────────────────────── -->
  <section class="my-10">
    <SectionTitle title="uses" />
    <Btop />
  </section>

  <!-- ── contact ───────────────────────────────────────── -->
  <section class="my-10">
    <SectionTitle title="contact" />
    <Mutt />
  </section>
</Layout>
