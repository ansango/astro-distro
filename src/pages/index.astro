---
import Layout from "../layouts/default.astro";
---

<Layout>
    <html lang="es">
        <head>
            <meta charset="UTF-8" />
            <meta
                name="viewport"
                content="width=device-width, initial-scale=1.0"
            />
            <title>ansango · pick your flavor</title>
            <meta
                name="description"
                content="ansango — portfolio estilo terminal"
            />
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link
                rel="preconnect"
                href="https://fonts.gstatic.com"
                crossorigin
            />
            <link
                href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&display=swap"
                rel="stylesheet"
            />
            <style>
                *,
                *::before,
                *::after {
                    margin: 0;
                    padding: 0;
                    box-sizing: border-box;
                }

                :root {
                    --bg: #0a0a0c;
                    --fg: #e0e0e0;
                    --dim: #6a6a6a;
                    --accent: #c8c8c8;
                    --border: #222226;
                }

                html {
                    scroll-behavior: smooth;
                }

                body {
                    background: var(--bg);
                    color: var(--fg);
                    font-family:
                        "JetBrains Mono", "Fira Code", "Courier New", monospace;
                    font-size: 14px;
                    line-height: 1.7;
                    min-height: 100vh;
                    -webkit-font-smoothing: antialiased;
                }

                main {
                    max-width: 880px;
                    margin: 0 auto;
                    padding: 3rem 1.5rem 4rem;
                }

                pre.picker {
                    font-family: inherit;
                    color: var(--fg);
                    font-size: 0.95rem;
                    line-height: 1.5;
                    white-space: pre;
                    overflow-x: auto;
                    margin: 0 0 2rem;
                }
                pre.picker .acc {
                    color: var(--accent);
                    font-weight: 500;
                }
                pre.picker .dim {
                    color: var(--dim);
                }
                pre.picker a {
                    color: var(--accent);
                    text-decoration: none;
                    font-weight: 500;
                }
                pre.picker a:hover {
                    text-decoration: underline;
                }
                pre.picker .desc {
                    color: var(--dim);
                }
                pre.picker .tag-debian {
                    color: #d70a53;
                }
                pre.picker .tag-ubuntu {
                    color: #e95420;
                }
                pre.picker .tag-arch {
                    color: #1793d1;
                }
                pre.picker .tag-fedora {
                    color: #3c6eb4;
                }
                pre.picker .tag-alpine {
                    color: #0d597f;
                }
                pre.picker .tag-suse {
                    color: #73ba25;
                }
                pre.picker .tag-macos {
                    color: #c0c0c0;
                }

                .hint {
                    margin-top: 1.5rem;
                    padding-top: 1.5rem;
                    border-top: 1px dashed var(--border);
                    color: var(--dim);
                    font-size: 0.85rem;
                }
                .hint code {
                    color: var(--fg);
                    background: rgba(255, 255, 255, 0.05);
                    padding: 0.1rem 0.4rem;
                    border-radius: 3px;
                }

                footer {
                    margin-top: 2.5rem;
                    padding-top: 1.2rem;
                    border-top: 1px dashed var(--border);
                    color: var(--dim);
                    font-size: 0.8rem;
                    display: flex;
                    justify-content: space-between;
                    flex-wrap: wrap;
                    gap: 1rem;
                }
                footer span::before {
                    content: "~ ";
                    color: var(--accent);
                }

                @media (max-width: 600px) {
                    main {
                        padding: 1.2rem 0.5rem 2rem;
                    }
                    pre.picker {
                        font-size: 0.55rem;
                    }
                }

                ::selection {
                    background: var(--accent);
                    color: var(--bg);
                }
            </style>
        </head>
        <body>
            <main>
                <pre
                    class="picker">


                  <span class="dim">~ pick your flavor ~</span>
                                                            <span class="dim">*</span>

  <span class="acc">~</span> <a href="debian.html">debian</a>          <span class="tag-debian">▰▰▰</span>  <span class="desc">rojo · bookworm · standard</span>
  <span class="acc">~</span> <a href="ubuntu.html">ubuntu</a>          <span class="tag-ubuntu">▰▰▰</span>  <span class="desc">naranja · noble · big</span>
  <span class="acc">~</span> <a href="arch.html">arch</a>            <span class="tag-arch">▰▰▰</span>  <span class="desc">azul · rolling · slant</span>
  <span class="acc">~</span> <a href="fedora.html">fedora</a>          <span class="tag-fedora">▰▰▰</span>  <span class="desc">azul · 40 · ansi shadow</span>
  <span class="acc">~</span> <a href="alpine.html">alpine</a>          <span class="tag-alpine">▰▰▰</span>  <span class="desc">azul oscuro · edge · small</span>
  <span class="acc">~</span> <a href="opensuse.html">opensuse</a>        <span class="tag-suse">▰▰▰</span>  <span class="desc">verde · tumbleweed · speed</span>
  <span class="acc">~</span> <a href="macos.html">macos</a>           <span class="tag-macos">▰▰▰</span>  <span class="desc">apple · sonoma · larry 3d</span>
</pre>

                <div class="hint">
                    <strong style="color: var(--fg);">v3:</strong> cabecera con <code
                        >ansango</code
                    > en ASCII art font (<strong>ANSI Shadow</strong>, estilo
                    patorjk) + drip effect y nombre de la distro abajo. Sin
                    logos raros. Las secciones (<code>~ about</code>, <code
                        >~ projects</code
                    >, <code>~ contact</code>), símbolos <code>~</code>, y gama
                    de colores por distro se mantienen.
                </div>

                <footer>
                    <span>uptime: since 2019</span>
                    <span>7 flavors · v3 · ansango font · no distro art</span>
                </footer>
            </main>
        </body>
    </html>
</Layout>
