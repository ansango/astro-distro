---
import DistroLogo from "@/components/logos/distro-logo.astro";
import SectionTitle from "@/components/section-title.astro";
import Btop from "@/components/tui/btop/index.astro";
import Lazygit from "@/components/tui/lazygit/index.astro";
import Mutt from "@/components/tui/mutt/index.astro";
import Ranger from "@/components/tui/ranger/index.astro";
import config from "@/config.json";
import Layout from "@/layouts/default.astro";

const { current, site, systems: distros } = config;
type System = (typeof distros)[number];

/** `perDistro` marca las filas cuyo valor cambia con la distro activa */
const info: {
  k: string;
  v?: string;
  dim?: boolean;
  perDistro?: (system: System) => string;
}[] = [
  { k: "OS", perDistro: (s) => s.os },
  { k: "Host", v: current.host },
  { k: "Kernel", perDistro: (s) => s.kernel },
  { k: "Packages", perDistro: (s) => `${s.pkgs} (${s.pkg})` },
  { k: "Shell", perDistro: (s) => s.shell },
  { k: "Resolution", v: current.resolution },
  { k: "DE", perDistro: (s) => s.de, dim: true },
  { k: "WM", perDistro: (s) => s.wm },
  { k: "Theme", perDistro: (s) => s.theme },
  { k: "Terminal", perDistro: (s) => s.terminal },
  { k: "Font", perDistro: (s) => s.font },
  { k: "CPU", v: current.cpu },
  { k: "GPU", v: current.gpu },
  { k: "Memory", v: current.memory },
];
---

<Layout
  title="astro-distro"
  description="astro-distro — Astro + Tailwind fastfetch-style portfolio template"
>
  <div class="mb-10 flex flex-col items-start md:flex-row gap-6 md:gap-12">
    <DistroLogo />
    <div>
      <div class="font-medium text-accent mb-1.5">
        <h1 class="inline border-b border-dim pb-0.5">
          {site.author}
          {site.handle_suffix && (<><span class="text-dim">@</span>{site.handle_suffix}</>)}
        </h1>
      </div>

      {info.map(({ k, v, dim, perDistro }) => (
                    <div class="mb-[0.05rem] flex items-center gap-2">
                        <span class="inline-block font-medium text-accent min-w-22.5">
                            {k}
                        </span>
                        {perDistro ? (
                            distros.map((distro) => (
                                <span data-distro={distro.slug}>
                                    {perDistro(distro)}
                                </span>
                            ))
                        ) : (
                            <span class:list={[dim && "text-dim"]}>{v}</span>
                        )}
                    </div>
                ))}
      <div class="mb-[0.05rem] flex items-center gap-2">
        <span class="inline-block font-medium text-accent min-w-22.5">
          Uptime
        </span>
        <span data-uptime class="text-dim">—</span>
      </div>
    </div>
  </div>

  <section class="my-10">
    <SectionTitle title="about" />
    <Lazygit />
  </section>

  <section class="my-10">
    <SectionTitle title="projects" />
    <Ranger />
  </section>

  <section class="my-10">
    <SectionTitle title="uses" />
    <Btop />
  </section>

  <section class="my-10">
    <SectionTitle title="contact" />
    <Mutt />
  </section>
</Layout>

<script is:inline define:vars={{ bootedAt: current.booted_at }}>
  const start = new Date(bootedAt).getTime();

  function formatUptime(ms) {
    const totalSeconds = Math.max(0, Math.floor(ms / 1000));
    const days = Math.floor(totalSeconds / 86400);
    const hours = Math.floor((totalSeconds % 86400) / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;

    const parts = [];
    if (days > 0) parts.push(`${days} day${days > 1 ? "s" : ""}`);
    if (hours > 0) parts.push(`${hours} hour${hours > 1 ? "s" : ""}`);
    if (minutes > 0) parts.push(`${minutes} minute${minutes > 1 ? "s" : ""}`);
    if (parts.length === 0)
      parts.push(`${seconds} second${seconds > 1 ? "s" : ""}`);
    return parts.join(", ");
  }

  const update = () => {
    const el = document.querySelector("[data-uptime]");
    if (!el) return;
    el.textContent = formatUptime(Date.now() - start);
  };

  update();
  setInterval(update, 1000);
</script>
