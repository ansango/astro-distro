---
import allLogos from "../components/logos";
const {
    logos: { small, large },
} = allLogos.find((logo) => logo.name === "arch");

import Layout from "../layouts/default.astro";
import Logo from "../components/logos/logo.astro";
---

<Layout>
    <html lang="es">
        <head>
            <meta charset="UTF-8" />
            <meta
                name="viewport"
                content="width=device-width, initial-scale=1.0"
            />
            <title>ansango · arch</title>
            <meta
                name="description"
                content="ansango — portfolio estilo terminal"
            />
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link
                rel="preconnect"
                href="https://fonts.gstatic.com"
                crossorigin
            />
            <link
                href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&display=swap"
                rel="stylesheet"
            />
            <style>
                *,
                *::before,
                *::after {
                    margin: 0;
                    padding: 0;
                    box-sizing: border-box;
                }

                :root {
                    --bg: #08090b;
                    --fg: #d8d8d8;
                    --dim: #5e6470;
                    --accent: #1793d1;
                    --accent-dim: #0d5a85;
                    --border: #1a1d22;
                }

                html {
                    scroll-behavior: smooth;
                }

                body {
                    background: var(--bg);
                    color: var(--fg);
                    font-family:
                        "JetBrains Mono", "Fira Code", "Courier New", monospace;
                    font-size: 14px;
                    line-height: 1.7;
                    min-height: 100vh;
                    -webkit-font-smoothing: antialiased;
                    -moz-osx-font-smoothing: grayscale;
                }

                main {
                    max-width: 820px;
                    margin: 0 auto;
                    padding: 3rem 1.5rem 4rem;
                }

                pre.header {
                    font-family: inherit;
                    color: var(--fg);
                    font-size: 0.95rem;
                    line-height: 1.15;
                    white-space: pre;
                    overflow-x: auto;
                    margin: 0 0 2.5rem;
                }
                pre.header .acc {
                    color: var(--accent);
                }
                pre.header .dim {
                    color: var(--dim);
                }

                .block {
                    margin: 2.5rem 0;
                }

                .section-title {
                    color: var(--accent);
                    font-size: 0.95rem;
                    letter-spacing: 0.05em;
                    margin-bottom: 1rem;
                    font-weight: 500;
                }
                .section-title::after {
                    content: " ────────────────────────────────────────────";
                    color: var(--border);
                    font-weight: 400;
                }

                .block p {
                    color: var(--fg);
                    max-width: 60ch;
                    margin-bottom: 0.8rem;
                }

                pre.cmd {
                    font-family: inherit;
                    color: var(--fg);
                    font-size: 0.82rem;
                    line-height: 1.55;
                    margin: 0.8rem 0;
                    white-space: pre;
                    overflow-x: auto;
                }
                pre.cmd .acc {
                    color: var(--accent);
                }
                pre.cmd .dim {
                    color: var(--dim);
                }
                pre.cmd .pkg {
                    color: var(--fg);
                }

                .items {
                    list-style: none;
                    display: flex;
                    flex-direction: column;
                    gap: 0.3rem;
                }
                .items li {
                    color: var(--fg);
                    font-size: 0.92rem;
                }
                .items li::before {
                    content: "~ ";
                    color: var(--accent);
                    font-weight: 500;
                }
                .items a {
                    color: var(--fg);
                    text-decoration: none;
                }
                .items a:hover {
                    color: var(--accent);
                    text-decoration: underline;
                }
                .items .dim {
                    color: var(--dim);
                }

                footer {
                    margin-top: 3.5rem;
                    padding-top: 1.2rem;
                    border-top: 1px dashed var(--border);
                    color: var(--dim);
                    font-size: 0.8rem;
                    display: flex;
                    justify-content: space-between;
                    flex-wrap: wrap;
                    gap: 1rem;
                }
                footer span::before {
                    content: "~ ";
                    color: var(--accent);
                }

                @media (max-width: 600px) {
                    main {
                        padding: 1.5rem 0.8rem 2rem;
                    }
                    pre.header {
                        font-size: 0.5rem;
                    }
                    pre.cmd {
                        font-size: 0.7rem;
                    }
                }

                ::selection {
                    background: var(--accent);
                    color: var(--bg);
                }
            </style>
        </head>
        <body>
            <main class="md:flex">
                <aside class="p-4">
                    <Logo small={small} large={large} />
                </aside>
                <div>
                    <section class="block">
                        <h2 class="section-title">~ about</h2>
                        <p>
                            Construyo software limpio, minimalista y funcional.
                            Me obsesionan los detalles pequeños: tipografía,
                            rendimiento, latencia, buenas APIs. Sí, uso Arch.
                            Sí, lo instalé a mano.
                        </p>
                        <pre
                            class="cmd">
<span class="acc">$</span> pacman -Qe | grep -E "^(typescript|rust|go|python|postgres|neovim|git)$"

<span class="pkg">typescript</span>  <span class="dim">5.4.2-1</span>
<span class="pkg">rust</span>        <span class="dim">1:1.76.0-1</span>
<span class="pkg">go</span>          <span class="dim">2:1.22.0-1</span>
<span class="pkg">python</span>     <span class="dim">3.11.8-1</span>
<span class="pkg">postgresql</span>  <span class="dim">15.6-1</span>
<span class="pkg">neovim</span>     <span class="dim">0.9.5-1</span>
<span class="pkg">git</span>        <span class="dim">2.43.0-1</span>
</pre>
                    </section>

                    <section class="block">
                        <h2 class="section-title">~ projects</h2>
                        <ul class="items">
                            <li>
                                <a
                                    href="https://github.com/ansango/alpha"
                                    target="_blank"
                                    rel="noopener">github.com/ansango/alpha</a
                                >
                                <span class="dim"
                                    >— CLI para automatizar flujos de dev</span
                                >
                            </li>
                            <li>
                                <a
                                    href="https://github.com/ansango/beta"
                                    target="_blank"
                                    rel="noopener">github.com/ansango/beta</a
                                >
                                <span class="dim"
                                    >— librería open-source de data viz</span
                                >
                            </li>
                            <li>
                                <a
                                    href="https://blog.ansango.dev"
                                    target="_blank"
                                    rel="noopener">blog.ansango.dev</a
                                >
                                <span class="dim"
                                    >— blog personal con generador estático</span
                                >
                            </li>
                            <li>
                                <a
                                    href="https://github.com/ansango/delta"
                                    target="_blank"
                                    rel="noopener">github.com/ansango/delta</a
                                >
                                <span class="dim"
                                    >— sistema de notas cifrado e2e</span
                                >
                            </li>
                        </ul>
                    </section>

                    <section class="block">
                        <h2 class="section-title">~ contact</h2>
                        <ul class="items">
                            <li>
                                <a
                                    href="https://github.com/ansango"
                                    target="_blank"
                                    rel="noopener">github.com/ansango</a
                                >
                            </li>
                            <li>
                                <a
                                    href="https://twitter.com/ansango"
                                    target="_blank"
                                    rel="noopener">twitter.com/ansango</a
                                >
                            </li>
                            <li>
                                <a href="mailto:hola@ansango.dev"
                                    >hola@ansango.dev</a
                                >
                            </li>
                        </ul>
                    </section>
                    <footer>
                        <span>uptime: since 2019</span>
                        <span>arch linux · rolling · btw</span>
                    </footer>
                </div>
            </main>
        </body>
    </html>
</Layout>
