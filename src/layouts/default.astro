---
import DistroToggle from "../components/distro-toggle.astro";
import config from "../config.json";
import { FONT_FAMILY, fontStack } from "../lib/fonts";
import { DEFAULT_THEME, STORAGE_KEY, themes } from "../lib/themes";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	/** slug de un sistema en `src/config.json` */
	theme?: string;
	lang?: string;
}

const {
	title,
	description = "",
	theme = DEFAULT_THEME,
	lang = "en",
} = Astro.props;

const distroVisibilityCss = [
	"[data-distro]{display:none}",
	...themes.map(
		(slug) => `[data-theme="${slug}"] [data-distro="${slug}"]{display:revert}`,
	),
].join("");

const themeColorsCss = config.systems
	.map(
		(s) =>
			`[data-theme="${s.slug}"]{--color-bg:${s.colors.bg};--color-panel:${s.colors.panel};--color-border:${s.colors.border};--color-fg:${s.colors.fg};--color-dim:${s.colors.dim};--color-accent:${s.colors.accent};--color-c1:${s.colors.c1};--color-c2:${s.colors.c2};--color-c3:${s.colors.c3};}`,
	)
	.join("");

const themeFontsCss = config.systems
	.map(
		(s) =>
			`[data-theme="${s.slug}"]{--font-mono:${fontStack(FONT_FAMILY[s.font])};}`,
	)
	.join("");
---

<!doctype html>
<html lang={lang} data-theme={theme} class="scroll-smooth">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="description" content={description}>
		<meta name="generator" content={Astro.generator}>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg">
		<title>{title}</title>
		<!-- aplica el tema guardado antes del primer paint para evitar el flash -->
		<script is:inline define:vars={{ themes, storageKey: STORAGE_KEY }}>
			const stored = localStorage.getItem(storageKey);
			if (stored && themes.includes(stored)) {
				document.documentElement.dataset.theme = stored;
			}
		</script>
		<style is:global set:html={distroVisibilityCss}></style>
		<style is:global set:html={themeColorsCss}></style>
		<style is:global set:html={themeFontsCss}></style>
	</head>
	<body
		class="min-h-screen bg-bg p-6 font-mono text-sm sm:text-base leading-normal text-fg antialiased selection:bg-accent selection:text-bg md:py-12"
	>
		<main class="mx-auto max-w-3xl">
			<slot />
		</main>

		<!-- ── footer ────────────────────────────────────────── -->
		<footer class="mx-auto max-w-3xl mt-10 text-dim">
			<div class="flex flex-wrap justify-between gap-2 text-[0.85rem]">
				<div class="flex flex-wrap items-center gap-2 text-[0.85rem]">
					<span class="text-accent">●</span>
					<span>session closed</span>
					<span class="text-border">·</span>
					<span>0 errors</span>
					<span class="text-border">·</span>
					<span>0 warnings</span>
					<span class="text-border">·</span>
					<span>uptime 5y</span>
					<span class="text-border">·</span>
				</div>
				<span class="text-border">·</span>
				<DistroToggle />
			</div>
		</footer>
	</body>
</html>
