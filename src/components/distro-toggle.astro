---
import { DEFAULT_THEME, themes } from "../lib/themes";
---

<div class="relative inline-block">
  <button
    id="theme-trigger"
    type="button"
    aria-haspopup="listbox"
    aria-expanded="false"
    class="cursor-pointer border border-border bg-panel px-2 py-1 text-fg hover:border-accent hover:text-accent"
  >
    <span class="text-dim">theme:</span>
    <span data-current-theme>{DEFAULT_THEME}</span>
    <span class="text-border">▾</span>
  </button>
  <ul
    id="theme-menu"
    hidden
    role="listbox"
    class="absolute right-0 bottom-full z-50 mb-1 max-h-64 w-44 overflow-y-auto border border-border bg-panel text-[0.75rem] shadow-lg"
  >
    {themes.map((theme) => (
			<li>
				<button
					type="button"
					data-theme-option={theme}
					role="option"
					aria-selected="false"
					class="block w-full cursor-pointer px-3 py-1 text-left text-dim hover:bg-fg/10 hover:text-accent aria-selected:text-accent"
				>
					{theme}
				</button>
			</li>
		))}
  </ul>
</div>

<script>
  import { DEFAULT_THEME, STORAGE_KEY, themes } from "../lib/themes";

  const root = document.documentElement;
  const trigger = document.getElementById(
    "theme-trigger",
  ) as HTMLButtonElement | null;
  const menu = document.getElementById("theme-menu") as HTMLUListElement | null;
  const label = document.querySelector<HTMLElement>("[data-current-theme]");
  const options = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-option]",
  );

  const isTheme = (value: string | null): value is (typeof themes)[number] =>
    !!value && (themes as readonly string[]).includes(value);

  function apply(theme: string) {
    root.dataset.theme = theme;
    localStorage.setItem(STORAGE_KEY, theme);
    if (label) label.textContent = theme;
    for (const option of options) {
      const selected = option.dataset.themeOption === theme;
      option.setAttribute("aria-selected", String(selected));
    }
  }

  function open() {
    if (!menu || !trigger) return;
    menu.hidden = false;
    trigger.setAttribute("aria-expanded", "true");
  }

  function close() {
    if (!menu || !trigger) return;
    menu.hidden = true;
    trigger.setAttribute("aria-expanded", "false");
  }

  function toggle() {
    if (!menu) return;
    if (menu.hidden) open();
    else close();
  }

  trigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    toggle();
  });

  menu?.addEventListener("click", (e) => e.stopPropagation());

  for (const option of options) {
    const theme = option.dataset.themeOption;
    if (theme) {
      option.addEventListener("click", (e) => {
        e.stopPropagation();
        apply(theme);
        close();
      });
    }
  }

  document.addEventListener("click", close);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });

  const stored = localStorage.getItem(STORAGE_KEY);
  apply(isTheme(stored) ? stored : (root.dataset.theme ?? DEFAULT_THEME));
</script>
