---
import config from "@/config.json";

export interface Props {
  /** page-specific title */
  title: string;
  /** overrides site.description */
  description?: string;
  /** overrides site.image (absolute URL or path relative to site.url) */
  image?: string;
  /** og:type — defaults to "website" */
  type?: "website" | "profile" | "article";
}

const site = config.site;
const social = site.social as Record<string, string>;
const { title, description, image, type = "website" } = Astro.props;

const desc = description ?? site.description;
const fullTitle = title.toLowerCase().includes(site.title.toLowerCase())
  ? title
  : `${title} · ${site.title}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = image
  ? new URL(image, site.url).href
  : new URL(site.image, site.url).href;

const sameAs = [
	social.github && `https://github.com/${social.github}`,
	social.twitter && `https://twitter.com/${social.twitter}`,
	social.linkedin && `https://linkedin.com/in/${social.linkedin}`,
].filter(Boolean);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: site.title,
	url: site.url,
	description: desc,
	image: ogImage,
	author: {
		"@type": "Person",
		name: site.author,
		jobTitle: site.job_title,
		url: site.url,
		sameAs,
	},
};
---

<!-- Primary -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle}>
<meta name="description" content={desc}>
<meta name="theme-color" content={site.theme_color}>
<link rel="canonical" href={canonical}>
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

<!-- Open Graph -->
<meta property="og:type" content={type}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={desc}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content={String(site.image_width)}>
<meta property="og:image:height" content={String(site.image_height)}>
<meta property="og:locale" content={site.locale}>
<meta property="og:site_name" content={site.title}>

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:url" content={canonical}>
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={desc}>
<meta name="twitter:image" content={ogImage}>
{site.twitter && (
  <meta name="twitter:creator" content={site.twitter} />
)}

<!-- Misc -->
<meta name="author" content={site.author}>

<!-- Structured data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
