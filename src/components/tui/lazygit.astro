---
import Prompt from "../prompt.astro";
import Status from "./lazygit/status.astro";
import Bio from "./lazygit/bio.astro";
import Paths from "./lazygit/paths.astro";

interface Props {
  status: {
    branch: string;
    since: string;
    modified: number;
    untracked: number;
  };
}

const {
  status = { branch: "main", since: "2019", modified: 3, untracked: 1 },
} = Astro.props as Props;
import Lazygit from "./lazygit/index.astro";
---

<Lazygit >
    <Status status={status} />
    <Bio/>
    <Paths/>
</Lazygit>

