---
import Container from "../commons/container.astro";
import Label from "../commons/label.astro";

export interface Props {
  /** directorio raíz mostrado en el árbol */
  root?: string;
  /** proyectos listados en el árbol */
  projects: { name: string; size: string; date: string }[];
  /** índice del proyecto seleccionado al cargar (default 0) */
  selectedIndex?: number;
}

const { root = "/home/ansango", projects, selectedIndex = 0 } = Astro.props;
---

<Container>
  <Label>tree</Label>
  <pre class="m-0 overflow-x-auto p-4 flex flex-col w-full" data-tree>
    <span class="text-dim">{root}</span>
    <span data-tree class="inline-flex gap-2">projects/<span class="text-dim">({projects.length} items)</span></span>
      {projects.map((project, i) => {
        return (
          <div
            data-tree-item={i}
            class={`flex gap-2 ml-8`}
            aria-last={i === projects.length - 1? "true" : "false"}
            >
            <button
               type="button"
               data-tree-item={i}
               class={`cursor-pointer hover:text-accent ${i === selectedIndex ? "text-accent" : ""}`}
             >{project.name}</button>
             <div class="flex gap-2 w-full justify-end">
               <span class="text-dim">{project.size}</span>
               <span class="text-dim">{project.date}</span>
             </div>
          </div>
        );
      })}
  </pre>
</Container>

<style>
  span[data-tree]::before {
    content: "└──";
  }

  div[data-tree-item]::before {
    content: "├──";
    color: var(--color-fg);
  }
  div[data-tree-item][aria-last="true"]::before {
    content: "└──";
  }
</style>
