---
import Container from "../commons/container.astro";
import Content from "../commons/content.astro";
import Label from "../commons/label.astro";

export interface Props {
  projects: {
    name: string;
    description: string;
    repo: string;
    stars: string;
    updated: string;
    url: string;
    homepage?: string;
  }[];
}

const { projects } = Astro.props;
---

{projects.map((project, i) => (
  <div data-detail={i} hidden={i !== 0} class="h-full">
    <Container>
      <Label>{project.name}</Label>
      <Content>
        <div class="mb-2">{project.description}</div>
        <div class="text-dim">{project.repo}</div>
        <div class="text-dim">{project.stars}· {project.updated}</div>
        <a
          class="mt-[0.4rem] inline-block text-accent hover:underline"
          href={project.url}
          target="_blank"
          rel="noopener"
          >→ repo</a
        >
        {project.homepage && (
          <a
            class="ml-3 text-accent hover:underline"
            href={project.homepage}
            target="_blank"
            rel="noopener"
            >→ visit site</a
          >
        )}
      </Content>
    </Container>
  </div>
))}
