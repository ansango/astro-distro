---
import config from "../../../config.json";
import Prompt from "../commons/prompt.astro";
import Detail from "./detail.astro";
import Tree from "./tree.astro";

const { command, root, projects } = config.sections.projects;
---

<Prompt cmd={command} class="mb-5" />
<div class="my-2 grid grid-cols-1">
  <Tree projects={projects} root={root} />
  <Detail projects={projects} />
</div>

<script>
  const items = document.querySelectorAll<HTMLButtonElement>(
    "button[data-tree-item]",
  );
  const details = document.querySelectorAll<HTMLElement>("[data-detail]");

  function select(idx: number) {
    items.forEach((el, i) => {
      el.classList.toggle("text-accent", i === idx);
    });
    details.forEach((el, i) => {
      el.hidden = i !== idx;
    });
  }

  items.forEach((el, i) => {
    el.addEventListener("click", () => select(i));
  });
</script>
