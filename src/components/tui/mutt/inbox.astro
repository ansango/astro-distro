---
export interface Mail {
  selected?: boolean;
  from: string;
  date: string;
  href: string;
}

export interface Props {
  mails: Mail[];
}

const { mails } = Astro.props;
---

<div class="font-mono my-2">
  {mails.map(({ from, date, href }) => (
    <a
      class="grid grid-cols-12 gap-x-4 group"
      href={href}
      target={href.startsWith("mailto:") ? undefined : "_blank"}
      rel={href.startsWith("mailto:") ? undefined : "noopener"}
    >
      <span class="col-span-3 hover:cursor-pointer group-hover:text-accent text-c2">
        {from}
      </span>
      <span class="col-span-9 flex justify-end text-dim">
        {date}
      </span>
    </a>
  ))}
</div>
