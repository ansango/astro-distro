---
export interface Mail {
  selected?: boolean;
  from: string;
  subject: string;
  date: string;
  href: string;
}

export interface Props {
  mails: Mail[];
}

const { mails } = Astro.props;
---

<div class="font-mono my-2 ">
  {mails.map(({  from, subject, date, href }) => (
    <a class="grid grid-cols-12 gap-x-4 group" href={href} target="_blank" rel="noopener">
      <span class={`col-span-3 md:col-span-3 hover:cursor-pointer group-hover:text-accent text-c2`}>
         <span>{from}</span>
      </span>
      <span class={`col-span-4 md:col-span-6`}>
         <span>{subject}</span>
      </span>
      <span class={`col-span-5 md:col-span-3 flex justify-end text-dim`}>

         <span>{date}</span>
      </span>
    </a>
  ))}
</div>
