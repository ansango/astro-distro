---
export interface Props {
  hints: { key: string; action: string }[];
}

const { hints } = Astro.props;
---

<div class="mt-2 text-[0.8rem] text-dim">
  {hints.map(({ key, action }, i) => (
    <span>
      {i > 0 && " · "}
      <span class="text-accent">{key}</span> {action}
    </span>
  ))}
</div>
