---
import Container from "../commons/container.astro";
import Content from "../commons/content.astro";
import Label from "../commons/label.astro";

export interface Props {
  mem: {
    used: number;
    total: number;
    theme: string;
    themePercent: number;
  };
}

const { mem } = Astro.props;

const usedPercent = (mem.used / mem.total) * 100;
---

<Container>
  <Label>MEM</Label>
  <Content>
    <div class="font-mono grid grid-cols-12 items-center gap-x-3 gap-y-1">
      <span class="col-span-3 sm:col-span-2">RAM</span>
      <span
        class="col-span-9 sm:col-span-10 md:col-span-5 flex items-center gap-2"
      >
        <span class="flex-1 h-4 bg-accent/10">
          <span
            class="block h-full bg-accent"
            style={`width: ${usedPercent}%`}
          />
        </span>

        <span class="text-dim whitespace-pre"
          >{String(usedPercent.toFixed(0)).padStart(3)}%</span
        >
      </span>
      <span
        class="col-span-12 md:ml-0 md:col-span-5 text-accent whitespace-pre flex gap-2"
      >
        <span class="text-dim whitespace-pre">{mem.used}/{mem.total} GB</span>
        {mem.theme}
        <span class="text-dim"> {mem.themePercent}%</span>
      </span>
    </div>
  </Content>
</Container>
