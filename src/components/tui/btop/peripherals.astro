---
import Container from "../commons/container.astro";
import Content from "../commons/content.astro";
import Label from "../commons/label.astro";

export interface Props {
	peripherals: {
		label?: string;
		keyboard?: string;
		mouse?: string;
		headphones?: string;
		monitor?: string;
	};
}

const { peripherals } = Astro.props;

// Recoge solo los campos definidos, en orden conocido. Si añades más
// periféricos al config basta con extender esta lista.
const items: { key: string; value: string }[] = [];
if (peripherals.keyboard) items.push({ key: "keyboard", value: peripherals.keyboard });
if (peripherals.mouse) items.push({ key: "mouse", value: peripherals.mouse });
if (peripherals.headphones) items.push({ key: "headphones", value: peripherals.headphones });
if (peripherals.monitor) items.push({ key: "monitor", value: peripherals.monitor });
---

<Container>
	<Label>{peripherals.label ?? "peripherals"}</Label>
	<Content>
		<div class="font-mono flex flex-wrap items-center gap-x-2 gap-y-1">
			{items.map(({ key, value }, i) => (
				<Fragment>
					{i > 0 && <span class="text-dim">·</span>}
					<span>
						<span class="text-fg">{key}</span>:
						<span class="text-accent"> {value}</span>
					</span>
				</Fragment>
			))}
		</div>
	</Content>
</Container>
