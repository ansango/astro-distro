---
import Container from "../commons/container.astro";
import Content from "../commons/content.astro";
import Label from "../commons/label.astro";

export interface Props {
  usage: {
    label: string;
    percent: number;
    detail: string;
    note?: string;
  }[];
}

const { usage } = Astro.props;
---

<Container>
  <Label>CPU [daily usage]</Label>
  <Content>
    <div
      class="font-mono grid grid-cols-12 items-center gap-x-3 gap-y-1 "
    >
      {usage.map(({ label, percent, detail, note }) => (
        <Fragment>
          <span class="col-span-3 sm:col-span-2">{label.padEnd(10)}</span>
          <span class="col-span-9 sm:col-span-10 md:col-span-5 flex items-center gap-2">
            <span class="flex-1 h-4 overflow-hidden bg-accent/10">
              <span
                class="block h-full bg-accent"
                style={`width: ${percent}%`}
              />
            </span>
            <span class="text-dim whitespace-pre"><span class="opacity-0">{percent < 100 ? "0" : ""}</span>{percent}%</span>
          </span>

          <span class="col-span-12 ml-2 md:ml-0 md:col-span-5 gap-2"><span class="line-clamp-1" >{detail} {note ? <span class="text-dim">{note}</span> : null}</span> </span>
        </Fragment>
      ))}
    </div>
  </Content>
</Container>
