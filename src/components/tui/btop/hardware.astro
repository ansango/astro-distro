---
import Container from "../commons/container.astro";
import Content from "../commons/content.astro";
import Label from "../commons/label.astro";

export interface Props {
  device?: string;
  ram?: string;
  os?: string;
}

const {
  device = "thinkpad x1 carbon gen 11",
  ram = "32gb ram",
  os = "arch linux",
} = Astro.props as Props;
---

<Container>
  <Label>hardware</Label>
  <Content>
    <div class="font-mono flex items-center gap-x-2">
      <span>{device}</span>
      <span class="text-dim">·</span>
      <span>{ram}</span>
      <span class="text-dim">·</span>
      <span class="text-accent">{os}</span>
    </div>
  </Content>
</Container>
