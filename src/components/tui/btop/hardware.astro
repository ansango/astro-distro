---
import Container from "@/components/tui/commons/container.astro";
import Content from "@/components/tui/commons/content.astro";
import Label from "@/components/tui/commons/label.astro";

export interface Props {
  device: string;
  ram: string;
  os: string;
}

const { device, ram, os } = Astro.props;
---

<Container>
  <Label>hardware</Label>
  <Content>
    <div class="font-mono flex items-center gap-x-2">
      <span>{device}</span>
      <span class="text-dim">·</span>
      <span>{ram}</span>
      <span class="text-dim">·</span>
      <span class="text-accent">{os}</span>
    </div>
  </Content>
</Container>
