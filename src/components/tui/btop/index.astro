---
import config from "../../../config.json";
import Prompt from "../commons/prompt.astro";
import Cpu from "./cpu.astro";
import Hardware from "./hardware.astro";
import Mem from "./mem.astro";
import Peripherals from "./peripherals.astro";

const uses = config.sections.uses;
---

<Prompt cmd={uses.command} class="mb-5" />
<div class="my-2 flex flex-col gap-5">
  <Cpu usage={uses.cpu.usage} />
  <Mem mem={uses.memory} />
  <Hardware
    device={uses.hardware.device}
    ram={uses.hardware.ram}
    os={uses.hardware.os}
  />
  <Peripherals peripherals={uses.peripherals} />
</div>
