---
import Container from "../commons/container.astro";
import Content from "../commons/content.astro";
import Label from "../commons/label.astro";
import Paragraph from "../commons/paragraph.astro";

export interface Item {
  icon: string;
  text: string;
}

export interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<Container>
  <Label>bio (modified)</Label>
  <Content>
    {items.map(item => (
      <Paragraph>
        <span class="font-medium text-accent" class:list={[item.icon === "??" ? "text-dim" :  ""]}>{item.icon}</span>  <span class:list={[item.icon === "??" ? "" :  "ml-2"]}>{item.text}</span>
      </Paragraph>
    ))}
  </Content>
</Container>
