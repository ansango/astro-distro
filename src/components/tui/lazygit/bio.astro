---
import Label from '../commons/label.astro';
import Paragraph from '../commons/paragraph.astro';
import Container from '../commons/container.astro';
import Content from '../commons/content.astro';

export interface Props {
  items: {
    icon: 'M' | '??' | '⎇' ;
    text: string;
  }[];
}

const {
  items = [
    { icon: 'M', text: 'Construyo software limpio, minimalista y funcional' },
    { icon: 'M', text: 'Me obsesionan los detalles pequeños: tipografía' },
    { icon: 'M', text: 'Rendimiento, latencia, buenas APIs' },
    { icon: '??', text: 'Construyo software limpio. Sí, uso Arch.' },
  ],
} = Astro.props as Props;
---

<Container>
  <Label>bio (modified)</Label>
  <Content>
    {items.map(item => (
      <Paragraph>
        <span class="font-medium text-accent" class:list={[item.icon === "??" ? "text-dim" :  ""]}>{item.icon}</span>  <span class:list={[item.icon === "??" ? "" :  "ml-2"]}>{item.text}</span>
      </Paragraph>
    ))}

</Content>
</Container>
