---
import Container from "@/components/tui/commons/container.astro";
import Content from "@/components/tui/commons/content.astro";
import Label from "@/components/tui/commons/label.astro";
import Paragraph from "@/components/tui/commons/paragraph.astro";

export interface Props {
  status: {
    branch: string;
    since: number;
    ahead?: number;
    behind?: number;
    modified: number;
    untracked: number;
  };
}

const { status } = Astro.props;

// Solo emitimos `↑N ahead` / `↓N behind` cuando hay commits sin sincronizar
const ahead = status.ahead ?? 0;
const behind = status.behind ?? 0;
const syncBits: string[] = [];
if (ahead > 0) syncBits.push(`↑${ahead} ahead`);
if (behind > 0) syncBits.push(`↓${behind} behind`);
---

<Container>
  <Label>status</Label>
  <Content>
    <Paragraph class="flex-wrap gap-0">
      <span class="font-medium text-accent mr-3">⎇ {status.branch}</span>
      · since {status.since} ·
      {syncBits.length > 0 && (
				<>
					<span class="text-fg ml-3">{syncBits.join(" · ")}</span>
					<span class="text-border"> · </span>
				</>
			)}
      <span class="text-dim"
        >+{status.modified}
        modified · {status.untracked} untracked</span
      >
    </Paragraph>
  </Content>
</Container>
