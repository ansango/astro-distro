---
import Container from "@/components/tui/commons/container.astro";
import Content from "@/components/tui/commons/content.astro";
import Label from "@/components/tui/commons/label.astro";
import Paragraph from "@/components/tui/commons/paragraph.astro";

export interface PathEntry {
  name: string;
  current?: boolean;
}

export interface Props {
  paths: PathEntry[];
}

const { paths } = Astro.props;
---

<Container>
  <Label>paths (local)</Label>
  <Content>
    {paths.map(({ name, current }) => (
      <Paragraph class={current ? "" : "ml-3.5"}>
        {current ? <span class="font-medium text-accent">* {name}</span> : name}
      </Paragraph>
    ))}
  </Content>
</Container>
