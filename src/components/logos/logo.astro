---
interface Props {
  logo: string;
  class?: string;
  "data-distro"?: string;
}

const { logo, class: className, ...rest } = Astro.props;
const COLOR_CLASSES = ["text-c1", "text-c2", "text-c3"] as const;
const escapeHtml = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

function toHtml(source: string): string {
  let color = 1;

  return source
    .replace(/\r\n/g, "\n")
    .replace(/^\n+|\n+$/g, "")
    .split("\n")
    .map((line) => {
      let html = "";
      let buffer = "";

      const flush = () => {
        if (!buffer) return;
        const index = Math.min(color, COLOR_CLASSES.length) - 1;
        html += `<span class="${COLOR_CLASSES[index]}">${escapeHtml(buffer)}</span>`;
        buffer = "";
      };

      for (let i = 0; i < line.length; i++) {
        if (line[i] !== "$" || i + 1 >= line.length) {
          buffer += line[i];
          continue;
        }

        const marker = line[++i];
        if (marker === "$") {
          buffer += "$";
          continue;
        }

        const index = Number(marker);
        if (Number.isInteger(index) && index >= 1 && index <= 9) {
          flush();
          color = index;
          continue;
        }

        buffer += `$${marker}`;
      }

      flush();
      return html;
    })
    .join("\n");
}
---

<pre
  {...rest}
  class:list={["leading-[0.82] md:leading-[0.75] whitespace-pre", className]}
  set:html={`<span class="text-2xs">${toHtml(logo)}</span>`}
/>
